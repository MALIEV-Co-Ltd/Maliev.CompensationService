{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maliev.com/schemas/compensation-changed-event.json",
  "title": "CompensationChangedEvent",
  "description": "Published when an employee's compensation is created or updated",
  "type": "object",
  "required": [
    "employeeId",
    "compensationRecordId",
    "newSalary",
    "previousSalary",
    "changePercentage",
    "effectiveDate",
    "changeReason"
  ],
  "properties": {
    "employeeId": {
      "type": "string",
      "format": "uuid",
      "description": "Employee unique identifier"
    },
    "compensationRecordId": {
      "type": "string",
      "format": "uuid",
      "description": "New compensation record identifier"
    },
    "newSalary": {
      "type": "number",
      "minimum": 0,
      "description": "New base salary amount"
    },
    "previousSalary": {
      "type": "number",
      "minimum": 0,
      "description": "Previous base salary amount (0 for initial compensation)"
    },
    "changeAmount": {
      "type": "number",
      "description": "Salary change amount (newSalary - previousSalary)"
    },
    "changePercentage": {
      "type": "number",
      "description": "Percentage change ((newSalary - previousSalary) / previousSalary * 100)"
    },
    "effectiveDate": {
      "type": "string",
      "format": "date-time",
      "description": "Effective date of the compensation change"
    },
    "changeReason": {
      "type": "string",
      "maxLength": 500,
      "description": "Reason for the compensation change"
    },
    "changedBy": {
      "type": "string",
      "format": "uuid",
      "description": "User who approved the change"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Event publication timestamp"
    }
  },
  "examples": [
    {
      "employeeId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "compensationRecordId": "7fa85f64-5717-4562-b3fc-2c963f66afa7",
      "newSalary": 92000.00,
      "previousSalary": 85000.00,
      "changeAmount": 7000.00,
      "changePercentage": 8.24,
      "effectiveDate": "2025-04-01T00:00:00Z",
      "changeReason": "Promotion to Senior Engineer",
      "changedBy": "1fa85f64-5717-4562-b3fc-2c963f66afa1",
      "timestamp": "2025-03-15T14:30:00Z"
    }
  ]
}
